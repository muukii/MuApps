    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo to attach to a journal entry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録に添付する写真を撮影するためにカメラを使用します。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach where you are to a journal entry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録に現在地を添付するために位置情報を使用します。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record the ambient sound around you to attach to a journal entry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録に添付する環境音を録音するためにマイクを使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a photo to attach to a journal entry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録に添付する写真を選ぶために写真ライブラリを使用します。"
          }
        }
      }
    }
